# Only these runtime inputs may enter the build context.
**
!Dockerfile
!.dockerignore
!backend/requirements.txt
!backend/app/**/*.py
!backend/migrations/001_feedback_save.sql
!backend/migrations/002_optional_dislike_reason.sql
!backend/migrations/003_feedback_reason_text.sql
!backend/migrations/baseline_003.sql
!frontend/index.html
!frontend/css/*.css
!frontend/js/*.js
!frontend/assets/afa-mark.svg
!frontend/assets/clomori-mark.svg
!frontend/assets/hero-editorial-model.jpg
!frontend/assets/hero-knit-detail.jpg
!frontend/assets/hero-styled-flatlay.jpg

# Never include local secrets or runtime data even under an allowed source path.
**/.env
**/.env.*
**/.secrets
**/credentials*.json
**/client_secret*.json
**/token*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.dump
**/*.backup
**/.wardrobe_media
**/wardrobe_media
**/uploads
**/backups
**/CLOMORI-local-backups
**/models
**/checkpoints
**/*.safetensors
**/*.gguf
**/*.bin
**/*.ckpt
**/*.pt
**/*.pth
