# SQLAlchemy URL. 이 값은 로컬 macOS 사용자와 같은 이름의 PostgreSQL 역할을 사용합니다.
DATABASE_URL=postgresql+psycopg:///ai_fashion_agent

# 최소 32자 이상의 예측 불가능한 값으로 반드시 교체합니다.
SESSION_SECRET_KEY=

# 로컬 HTTP 개발에서만 false를 사용하고, HTTPS 환경에서는 true로 설정합니다.
SESSION_COOKIE_SECURE=false

# Kakao Local API
KAKAO_REST_API_KEY=

# 기상청 단기예보 API
KMA_SERVICE_KEY=

# Google Calendar 웹 OAuth 클라이언트. 다운로드한 JSON 자체는 저장소에 두지 않습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback

# Access/Refresh Token DB 암호화 전용 Fernet 키. SESSION_SECRET_KEY와 다른 키를 사용합니다.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# SerpApi Google Shopping 이미지 조회. 공개 서비스에서는 이미지 표시 권한 확인 후 활성화합니다.
SERPAPI_API_KEY=
SERPAPI_IMAGE_SEARCH_ENABLED=false
SERPAPI_TIMEOUT_SECONDS=8

# 추론 엔진: 기본 mock. 모델 학습·서버 준비 후 qwen으로 바꾸고 백엔드를 재시작합니다.
# 팀이 실행한 Qwen 서버를 사용합니다. OpenAI API 키는 필요하지 않습니다.
AGENT_INFERENCE_PROVIDER=mock
# /v1까지 지정합니다. 8000은 FastAPI이므로 추론 서버는 별도 포트를 사용합니다.
QWEN_BASE_URL=http://127.0.0.1:8001/v1
# 진호가 전달한 학습 결과를 로드한 서버의 /v1/models ID (기본 모델 ID로 대체하지 않음)
QWEN_MODEL=
# 로컬 서버에서 인증을 켠 경우에만 설정. 실제 값은 Git에 넣지 않습니다.
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_TOKENS=4096
QWEN_RESPONSE_FORMAT=json_schema
# vLLM에서 지원을 확인한 후 true. LM Studio 등은 기본 false, 서버에서 thinking 비활성화.
QWEN_SEND_CHAT_TEMPLATE_KWARGS=false
QWEN_MAX_INPUT_CHARS=60000
QWEN_MAX_RESPONSE_BYTES=524288
