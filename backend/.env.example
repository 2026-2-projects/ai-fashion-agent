# SQLAlchemy URL. 이 값은 로컬 macOS 사용자와 같은 이름의 PostgreSQL 역할을 사용합니다.
DATABASE_URL=postgresql+psycopg:///ai_fashion_agent

# 최소 32자 이상의 예측 불가능한 값으로 반드시 교체합니다.
SESSION_SECRET_KEY=

# 로컬 HTTP 개발에서만 false를 사용하고, HTTPS 환경에서는 true로 설정합니다.
SESSION_COOKIE_SECURE=false

# Kakao Local API
KAKAO_REST_API_KEY=

# 기상청 단기예보 API
KMA_SERVICE_KEY=

# Google Calendar 웹 OAuth 클라이언트. 다운로드한 JSON 자체는 저장소에 두지 않습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback

# Access/Refresh Token DB 암호화 전용 Fernet 키. SESSION_SECRET_KEY와 다른 키를 사용합니다.
GOOGLE_TOKEN_ENCRYPTION_KEY=
